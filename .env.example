APP_NAME=TLMTI
APP_DEBUG=0
APP_TIMEZONE=Asia/Kolkata

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tlmti
DB_USER=root
DB_PASS=

# Local XAMPP default. Set redis after installing phpredis and starting Redis.
SESSION_DRIVER=files
SESSION_TTL_MINUTES=120
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_SESSION_DB=1
REDIS_PASSWORD=
REDIS_TLS=0
